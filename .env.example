# ========================================
# Language Configuration
# ========================================
# Interface language: 'en' (English) or 'es' (Spanish)
# Default: en
LANGUAGE=en

# ========================================
# Download Configuration
# ========================================
# Time in minutes before downloaded files expire and are deleted
# Default: 15
DOWNLOAD_TTL_MINUTES=15

# How often (in minutes) the cleanup process runs to remove expired files
# Default: 5
DOWNLOAD_CLEANUP_INTERVAL_MINUTES=5

# Maximum file size allowed for downloads (in MB)
# Default: 500
DOWNLOAD_MAX_FILE_SIZE_MB=500

# Max times a file can be downloaded before automatic deletion
# 0 = unlimited downloads (files only deleted by TTL expiration)
# 1 = single download (deleted immediately after first download)
# N = allow N downloads before deletion
# Default: 1
DOWNLOAD_MAX_DOWNLOADS_PER_FILE=1

# Directory for temporary file storage
# Default: temp
DOWNLOAD_TEMP_DIR=temp

# Maximum number of concurrent downloads allowed server-wide
# Default: 3
DOWNLOAD_MAX_CONCURRENT=3

# Maximum number of items to download from a playlist
# Default: 5
DOWNLOAD_MAX_PLAYLIST_ITEMS=5

# ========================================
# Rate Limiting Configuration
# ========================================
# Maximum number of downloads allowed per IP address in the time window
# Default: 5
DOWNLOAD_RATE_LIMIT_MAX=5

# Time window in minutes for rate limiting
# Default: 60 (1 hour)
DOWNLOAD_RATE_LIMIT_WINDOW_MINUTES=60

# ========================================
# Auto-Update Configuration
# ========================================
# Enable automatic updates of yt-dlp and SomeDL while the server is running
# The startup update (via Docker entrypoint) always runs regardless
# Default: true
UPDATER_ENABLED=true

# How often (in hours) to check for updates while the server is running
# Default: 24
UPDATER_INTERVAL_HOURS=24

# ========================================
# Reverse Proxy Configuration
# ========================================
# Trust the X-Forwarded-For header from one reverse proxy hop
# (Nginx, Caddy, Cloudflare Tunnel, etc.) to get the real client IP.
# Enable ONLY when Amia is behind a proxy, otherwise clients can spoof their IP
# and bypass rate limiting.
# Default: false
TRUST_PROXY=false
